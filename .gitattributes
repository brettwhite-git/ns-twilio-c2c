# .gitattributes — file-attribute policies for the repo
#
# linguist-generated=true tells GitHub:
#   1. Exclude the file from language-stat percentages (so the repo language
#      breakdown reflects authored code, not bundled output)
#   2. Collapse the file by default in PR diff view (so reviewers see source
#      .tsx/.ts changes without bundle .js noise)
#
# We commit the SPA bundle output (SpaClient.js, SpaServer.js) deliberately —
# fresh-clone deploys must work without an npm install + gulp bundle prereq.
# But the .js files are mechanically derived from .tsx source by gulp + rollup,
# so they shouldn't add review noise or skew language stats.
#
# Drift between source and committed bundle is prevented by the GitHub Actions
# CI gate that runs `npm run bundle && git diff --exit-code <bundle-paths>` on
# every PR. See .github/workflows/ci.yml.

# SPA bundle output — generated by `gulp bundle` from src/SuiteApps/.../*.tsx
src/FileCabinet/SuiteApps/com.netsuite.clicktocall/setup_wizard/*.js linguist-generated=true

# Vendored Twilio Voice SDK (not authored here)
src/FileCabinet/SuiteApps/com.netsuite.clicktocall/lib/twilio.min.js linguist-generated=true linguist-vendored=true
