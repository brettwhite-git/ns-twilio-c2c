<suitelet scriptid="customscript_ctc_sl_setup_wizard">
    <name>CTC Setup Wizard</name>
    <scriptfile>[/SuiteApps/com.netsuite.clicktocall/click_to_call/ctc_sl_setup_wizard.js]</scriptfile>
    <notifyadmins>F</notifyadmins>
    <notifyemails></notifyemails>
    <notifyowner>T</notifyowner>
    <notifyuser>F</notifyuser>
    <isinactive>F</isinactive>
    <loglevel>DEBUG</loglevel>
    <scriptdeployments>
        <scriptdeployment scriptid="customdeploy_ctc_sl_setup_wizard">
            <title>CTC Setup Wizard</title>
            <isdeployed>T</isdeployed>
            <status>RELEASED</status>
            <loglevel>DEBUG</loglevel>
            <!-- SECURITY (SDF Pitfall #135): isonline=F requires login. Wizard
                 writes to NetSuite Secrets, flips activation, submits Employee
                 records — must never run anonymously. Always set explicitly;
                 do not rely on implicit defaults. -->
            <isonline>F</isonline>
            <!-- Audience: all internal roles can REACH the URL; the Suitelet's
                 runtime onRequest immediately gates non-admin role IDs and
                 returns an access-denied HTML page. Runtime gating (Layer 2
                 in the plan) is the actual security boundary; the deployment
                 audience just controls who can hit the URL.

                 Note: an earlier draft tried <permittedrole>ADMINISTRATOR
                 </permittedrole> on this deployment — that element is NOT
                 valid on a <scriptdeployment> (it belongs on customrecord
                 <permissions> blocks) and SDF silently ignored it, leaving
                 the deployment with no audience and locking out every role
                 including ADMINISTRATOR. Centerlink-level audience controls
                 who SEES the menu link; deployment-level audience controls
                 who can hit the URL even if they have it. -->
            <allroles>T</allroles>
            <!-- NO <runasrole> (SDF security guide: never <runasrole>ADMINISTRATOR</runasrole>
                 in production — privilege-escalation antipattern). The calling
                 admin's own privileges authorize the writes. -->
        </scriptdeployment>
    </scriptdeployments>
</suitelet>
