<customrecordtype scriptid="customrecord_ctc_config">
    <recordname>CTC Configuration</recordname>
    <description>Configuration for Click-to-Call. Managed exclusively by the Setup Wizard SPA. Hidden from admin UI via allowuiaccess=F; edit only via the wizard. Runtime reads remain open (accesstype=NONENEEDED) so non-admin scripts (poller, softphone, phone-button) can read config without role-checking workarounds (per SAFE Guide §5.2).</description>
    <allowuiaccess>F</allowuiaccess>
    <includeinsearchmenu>F</includeinsearchmenu>
    <includename>F</includename>
    <accesstype>NONENEEDED</accesstype>
    <allowattachments>F</allowattachments>
    <allowinlinedeleting>F</allowinlinedeleting>
    <allowinlineinsert>F</allowinlineinsert>
    <allowquickadd>F</allowquickadd>
    <allowquicksearch>F</allowquicksearch>
    <enablemailmerge>F</enablemailmerge>
    <enablenumbering>F</enablenumbering>
    <enablesystemnotes>T</enablesystemnotes>
    <isinactive>F</isinactive>
    <numberingprefix></numberingprefix>
    <permissions>
        <permission>
            <permittedrole>ADMINISTRATOR</permittedrole>
            <permittedlevel>FULL</permittedlevel>
            <restriction>EDIT</restriction>
        </permission>
    </permissions>
    <customrecordcustomfields>
        <customrecordcustomfield scriptid="custrecord_ctc_account_sid">
            <label>Account SID</label>
            <fieldtype>CLOBTEXT</fieldtype>
            <ismandatory>T</ismandatory>
            <displaytype>NORMAL</displaytype>
        </customrecordcustomfield>
        <customrecordcustomfield scriptid="custrecord_ctc_api_key_sid">
            <label>API Key SID</label>
            <fieldtype>CLOBTEXT</fieldtype>
            <ismandatory>T</ismandatory>
            <displaytype>NORMAL</displaytype>
        </customrecordcustomfield>
        <customrecordcustomfield scriptid="custrecord_ctc_api_secret_id">
            <label>API Key Secret ID</label>
            <description>Script ID from Setup &gt; Company &gt; API Secrets (e.g., custsecret_ctc_api_key_secret)</description>
            <fieldtype>CLOBTEXT</fieldtype>
            <ismandatory>T</ismandatory>
            <displaytype>NORMAL</displaytype>
        </customrecordcustomfield>
        <customrecordcustomfield scriptid="custrecord_ctc_twiml_app_sid">
            <label>TwiML App SID</label>
            <fieldtype>CLOBTEXT</fieldtype>
            <ismandatory>T</ismandatory>
            <displaytype>NORMAL</displaytype>
        </customrecordcustomfield>
        <customrecordcustomfield scriptid="custrecord_ctc_phone_number">
            <label>Caller ID Number</label>
            <fieldtype>PHONE</fieldtype>
            <ismandatory>T</ismandatory>
            <displaytype>NORMAL</displaytype>
        </customrecordcustomfield>
        <customrecordcustomfield scriptid="custrecord_ctc_intel_service_sid">
            <label>Intelligence Service SID</label>
            <fieldtype>CLOBTEXT</fieldtype>
            <ismandatory>F</ismandatory>
            <displaytype>NORMAL</displaytype>
        </customrecordcustomfield>
        <customrecordcustomfield scriptid="custrecord_ctc_active">
            <label>CTC Activated</label>
            <description>Flipped to T by the v2 Setup Wizard when all preflight checks pass. The phone-icon User Event script reads this flag and stays hidden until activation succeeds, so reps never see a half-configured icon. Default F on fresh installs.</description>
            <fieldtype>CHECKBOX</fieldtype>
            <ismandatory>F</ismandatory>
            <defaultvalue>F</defaultvalue>
            <displaytype>NORMAL</displaytype>
        </customrecordcustomfield>
    </customrecordcustomfields>
</customrecordtype>
