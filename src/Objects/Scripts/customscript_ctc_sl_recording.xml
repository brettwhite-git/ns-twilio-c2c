<suitelet scriptid="customscript_ctc_sl_recording">
    <name>CTC Call Recording Audio</name>
    <scriptfile>[/SuiteApps/com.netsuite.clicktocall/ctc_sl_recording.js]</scriptfile>
    <notifyadmins>F</notifyadmins>
    <notifyemails></notifyemails>
    <notifyowner>T</notifyowner>
    <notifyuser>F</notifyuser>
    <status>RELEASED</status>
    <isinactive>F</isinactive>
    <loglevel>DEBUG</loglevel>
    <scriptdeployments>
        <scriptdeployment scriptid="customdeploy_ctc_sl_recording">
            <title>CTC Call Recording Audio</title>
            <isdeployed>T</isdeployed>
            <status>RELEASED</status>
            <!-- Runs at AUDIT so the "CTC Recording played" line (who
                 listened to which call) is kept; see ctc_rl_token.xml for
                 the deployment log level rationale. -->
            <loglevel>AUDIT</loglevel>
            <allroles>T</allroles>
            <isonline>F</isonline>
        </scriptdeployment>
    </scriptdeployments>
</suitelet>
