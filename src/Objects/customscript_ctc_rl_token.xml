<restlet scriptid="customscript_ctc_rl_token">
    <name>CTC Token Generator</name>
    <scriptfile>[/SuiteApps/com.netsuite.clicktocall/click_to_call/ctc_rl_token.js]</scriptfile>
    <notifyadmins>F</notifyadmins>
    <notifyemails></notifyemails>
    <notifyowner>T</notifyowner>
    <notifyuser>F</notifyuser>
    <status>RELEASED</status>
    <isinactive>F</isinactive>
    <loglevel>DEBUG</loglevel>
    <scriptdeployments>
        <scriptdeployment scriptid="customdeploy_ctc_rl_token">
            <title>CTC Token Generator</title>
            <isdeployed>T</isdeployed>
            <status>RELEASED</status>
            <!-- HIGH-10 (SAFE review 2026-05-21) — production deployment
                 must run at ERROR. Script-level loglevel above remains
                 DEBUG as the max-level cap for local dev. BFN reviewers
                 consistently flag DEBUG in production: every user
                 interaction would write log.debug entries containing
                 entityId, callSid, found counts, etc. to a 30-day-
                 retained log with no automatic PII scrubbing. -->
            <loglevel>ERROR</loglevel>
            <allroles>T</allroles>
        </scriptdeployment>
    </scriptdeployments>
</restlet>
