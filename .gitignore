# the originals with real customer/phone/account data stay out of git.
assets/screenshots/_raw/

# Output of 'npm pack'
*.tgz

# Project config
project.json
.compound-engineering/*.local.yaml

# Secrets
.env
private-key.pem
certificate.pem

# Local agent workflow + internal docs (not for public GitHub view)
.claude/
.compound-engineering/
AGENTS.md
ARCHITECTURE.md
BUILD_PLAN.md
CHANGELOG.md
CLAUDE.md
docs/
tasks/

# Unit tests + mocks — kept local-only, not for public GitHub view (like docs/,
# tasks/, CLAUDE.md above). Tests are gated by a local pre-push git hook
# (.git/hooks/pre-push runs `npm test`) instead of GitHub Actions, so they
# never enter the pushed tree. The CI Jest step was removed in the same change.
# NOTE: a fresh clone won't have these files or the hook — recover from a
# machine that has them, or from git history prior to this change.
__tests__/
__mocks__/

# Pre-JSX legacy archive — kept on disk for local reference but not
# tracked in git. Recovery: git history preserves the original
# locations via the Phase 4-6 JSX rewrite commits (7ec5c64, add234a,
# a1c3824, 53d1861).
_archive/
