// Path A scaffolding (added 2026-05-21) — type-check-only configuration.
//
// We're not transpiling TypeScript; we're letting tsc validate our hand-
// written AMD JS against the canonical @oracle/netsuite-uif-types catalog
// so the IDE (VS Code) can autocomplete UIF component APIs and so we can
// opt-in to per-file type checking via // @ts-check.
//
// Path B (landed 2026-05-26) added tsconfig.build.json as a sibling for
// the SPA TypeScript build. The two tsconfigs coexist with disjoint
// `include` blocks:
//   - this file:           src/FileCabinet/.../**/*.js   (hand-written AMD)
//   - tsconfig.build.json: src/SuiteApps/**/*.ts                       (new TS sources → gulp ESM→AMD pipeline)
//
// `npm run typecheck` still uses THIS file (type-check-only on hand-
// written AMD). `npm run build` uses tsconfig.build.json via gulp's
// gulp-typescript task. Plan: docs/plans/2026-05-22-001-spa-canonical-
// scaffolding-migration.md
{
  "compilerOptions": {
    "target": "ES2020",
    // Path B (2026-05-26) — switched from deprecated `AMD` to
    // `ESNext`. Our hand-written files use `define([...])` as an
    // ambient global (declared in types/netsuite-globals.d.ts), so
    // TS's module-emit format doesn't actually matter for type-check.
    // ESNext + Bundler resolution avoids the TS 7.0 deprecations.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    // Map the @uif-js/* AMD module specifiers used in SpaClient.js +
    // SpaServer.js to the Oracle type-only package. NetSuite's runtime
    // resolves these to its hosted UIF bundle; locally these are types-only.
    //
    // Path B (2026-05-26) — removed `baseUrl` (deprecated in TS 7.0)
    // and switched paths to ./-prefixed relative form, which is the
    // modern equivalent and matches Oracle's 2025.1+ sample tsconfigs.
    "paths": {
      "@uif-js/core": ["./node_modules/@oracle/netsuite-uif-types/uif/core"],
      "@uif-js/component": ["./node_modules/@oracle/netsuite-uif-types/uif/component"]
    }
  },
  "include": [
    "src/FileCabinet/SuiteApps/com.netsuite.clicktocall/**/*.js",
    // Path B (B.3+, 2026-05-27) — include the SPA TypeScript source tree
    // so VS Code's TS Language Server resolves @uif-js/* paths and
    // cross-module imports for files under setup_wizard/sections/ and
    // setup_wizard/render/. Without this, opening a TS file in VS Code
    // triggers TS2307 "Cannot find module" red squigglies on the UIF
    // imports — even though gulp's tsconfig.build.json builds cleanly.
    "src/SuiteApps/com.netsuite.clicktocall/**/*.ts",
    "src/SuiteApps/com.netsuite.clicktocall/**/*.tsx",
    "node_modules/@oracle/netsuite-uif-types/uif/*.d.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/FileCabinet/SuiteApps/com.netsuite.clicktocall/lib/twilio.min.js",
    "**/__tests__/**",
    "**/__mocks__/**",
    "build",
    "dist",
    // Path B (2026-05-26) — exclude gulp-generated AMD output. The
    // setup_wizard/ subdir under FileCabinet is regenerated by
    // `gulp bundle` from src/SuiteApps/.../setup_wizard/*.ts. We
    // type-check the TS sources, not the compiled output.
    "src/FileCabinet/SuiteApps/com.netsuite.clicktocall/setup_wizard"
  ]
}
